{
  "name": "anatomy-lab",
  "version": "0.12.0",
  "description": "Interaktive biomechanische Lehrmodelle im Browser – Schulterlabor (weitere Körperregionen folgen)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs shoulder",
    "test": "node --test tests/*.test.mjs",
    "shots": "node tests/shots.mjs",
    "shots:leg": "node tests/tools/shots-leg.mjs",
    "check": "npm run build && npm test",
    "serve": "npx --yes serve -l 8080 ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joergs-git/anatomy-lab.git"
  },
  "homepage": "https://joergs-git.github.io/anatomy-lab/",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "three": "0.128.0"
  }
}
